[[" وَٱلْعَـٰدِيَـٰتِ ضَبْحًا",599,30,239,0,"أقسم الله تعالى بالخيل الجاريات في سبيله نحو العدوِّ، حين يظهر صوتها من سرعة عَدْوِها. ولا يجوز للمخلوق أن يقسم إلا بالله، فإن القسم بغير الله شرك.","وَالْعَادِيَاتِ ضَبْحًا",[[3,4,"hw"],[8,10,"mn"],[14,16,"mn"],[21,23,"qq"]]],["فَٱلْمُورِيَـٰتِ قَدْحًا",599,30,239,0,"فالخيل اللاتي تنقدح النار من صلابة حوافرها؛ من شدَّة عَدْوها.","فَالْمُورِيَاتِ قَدْحًا",[[2,3,"hw"],[12,14,"mn"],[19,21,"qq"]]],["فَٱلْمُغِيرَٰتِ صُبْحًا",599,30,239,0,"فالخيل التي تغير بركبانها على الأعداء عند الصبح.","فَالْمُغِيرَاتِ صُبْحًا",[[2,3,"hw"],[11,13,"mn"],[18,20,"qq"]]],["فَأَثَرْنَ بِهِۦ نَقْعًا",599,30,239,0,"فهيَّجْنَ بهذا العَدْو غبارًا.","فَأَثَرْنَ بِهِ نَقْعًا",[[14,16,"mn"],[19,21,"qq"]]],["فَوَسَطْنَ بِهِۦ جَمْعًا",599,30,239,0,"فتوسَّطن بركبانهن جموع الأعداء.","فَوَسَطْنَ بِهِ جَمْعًا",[[6,8,"qq"],[14,16,"mn"]]],["إِنَّ ٱلْإِنسَـٰنَ لِرَبِّهِۦ لَكَنُودٌ",600,30,239,0,"إن الإنسان لِنعم ربه لَجحود، وإنه بجحوده ذلك لمقر. وإنه لحب المال لشديد.","إِنَّ الْإِنسَانَ لِرَبِّهِ لَكَنُودٌ",[[2,4,"gh"],[6,7,"hw"],[11,13,"ik"],[14,16,"mn"],[27,29,"mn"],[35,37,"mp"],[37,38,"qq"]]],["وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ",600,30,239,0,5,"وَإِنَّهُ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ",[[4,6,"gh"],[9,10,"mn"],[19,21,"mn"],[31,33,"mp"],[33,34,"qq"]]],["وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ",600,30,239,0,5,"وَإِنَّهُ لِحُبِّ الْخَيْرِ لَشَدِيدٌ",[[4,6,"gh"],[9,10,"mn"],[19,20,"hw"],[34,36,"mp"],[36,37,"qq"]]],["۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ",600,30,240,0,"أفلا يعلم الإنسان ما ينتظره إذا أخرج الله الأموات من القبور للحساب والجزاء؟","أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِي الْقُبُورِ",[[42,43,"hw"],[48,50,"mp"]]],["وَحُصِّلَ مَا فِى ٱلصُّدُورِ",600,30,240,0,"واستُخرج ما استتر في الصدور من خير أو شر.","وَحُصِّلَ مَا فِي الصُّدُورِ",[[18,19,"hw"],[19,20,"ls"],[24,26,"mp"]]],["إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍ لَّخَبِيرٌۢ",600,30,240,0,"إن ربهم بهم وبأعمالهم يومئذ لخبير، لا يخفى عليه شيء من ذلك.","إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍ لَّخَبِيرٌ",[[2,4,"gh"],[12,16,"is"],[30,34,"dw"],[39,41,"mp"]]]]