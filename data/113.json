[[" قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ",604,30,240,0,"قل -أيها الرسول-: أعوذ وأعتصم برب الفلق، وهو الصبح.","قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ",[[22,23,"hw"],[29,30,"qq"]]],["مِن شَرِّ مَا خَلَقَ",604,30,240,0,"من شر جميع المخلوقات وأذاها.","مِن شَرِّ مَا خَلَقَ",[[2,5,"ik"],[18,19,"qq"]]],["وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ",604,30,240,0,"ومن شر ليل شديد الظلمة إذا دخل وتغلغل، وما فيه من الشرور والمؤذيات.","وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ",[[4,7,"ik"],[30,31,"qq"]]],["وَمِن شَرِّ ٱلنَّفَّـٰثَـٰتِ فِى ٱلْعُقَدِ",604,30,240,0,"ومن شر الساحرات اللاتي ينفخن فيما يعقدن من عُقَد بقصد السحر.","وَمِن شَرِّ النَّفَّاثَاتِ فِي الْعُقَدِ",[[4,7,"ik"],[12,13,"hw"],[13,14,"ls"],[14,16,"gh"],[20,22,"mn"],[24,26,"mn"],[33,34,"hw"],[40,41,"qq"]]],["وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ",604,30,240,0,"ومن شر حاسد مبغض للناس إذا حسدهم على ما وهبهم الله من نعم، وأراد زوالها عنهم، وإيقاع الأذى بهم.","وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ",[[4,7,"ik"],[30,31,"qq"]]]]