[[" ٱلْقَارِعَةُ",600,30,240,0,"الساعة التي تقرع قلوب الناس بأهوالها.","الْقَارِعَةُ",[]],["مَا ٱلْقَارِعَةُ",600,30,240,0,"أيُّ شيء هذه القارعة؟","مَا الْقَارِعَةُ",[[4,5,"hw"]]],["وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ",600,30,240,0,"وأيُّ شيء أعلمك بها؟","وَمَا أَدْرَاكَ مَا الْقَارِعَةُ",[[3,6,"mo"],[9,11,"qq"],[13,15,"mn"],[22,23,"hw"]]],["يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ",600,30,240,0,"في ذلك اليوم يكون الناس في كثرتهم وتفرقهم وحركتهم كالفراش المنتشر، وهو الذي يتساقط في النار.","يَوْمَ يَكُونُ النَّاسُ كَالْفَرَاشِ الْمَبْثُوثِ",[[15,16,"hw"],[16,17,"ls"],[17,19,"gh"],[26,27,"hw"],[37,38,"hw"],[42,44,"qq"],[45,47,"mp"]]],["وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ",600,30,240,0,"وتكون الجبال كالصوف متعدد الألوان الذي يُنْفَش باليد، فيصير هباء ويزول.","وَتَكُونُ الْجِبَالُ كَالْعِهْنِ الْمَنفُوشِ",[[10,11,"hw"],[23,24,"hw"],[33,34,"hw"],[38,40,"ik"],[40,42,"mp"]]],["فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ",600,30,240,0,"فأما من رجحت موازين حسناته، فهو في حياة مرضية في الجنة.","فَأَمَّا مَن ثَقُلَتْ مَوَازِينُهُ",[[4,6,"gh"],[11,14,"ik"],[25,27,"mn"]]],["فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ",600,30,240,0,5,"فَهُوَ فِي عِيشَةٍ رَّاضِيَةٍ",[[16,20,"dw"]]],["وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ",600,30,240,0,"وأما من خفت موازين حسناته، ورجحت موازين سيئاته، فمأواه جهنم.","وَأَمَّا مَنْ خَفَّتْ مَوَازِينُهُ",[[4,6,"gh"],[25,27,"mn"]]],["فَأُمُّهُۥ هَاوِيَةٌ",600,30,240,0,7,"فَأُمُّهُ هَاوِيَةٌ",[[4,6,"gh"],[9,10,"mn"]]],["وَمَآ أَدْرَىٰكَ مَا هِيَهْ",600,30,240,0,"وما أدراك -أيها الرسول- ما هذه الهاوية؟","وَمَا أَدْرَاكَ مَا هِيَهْ",[[3,6,"mo"],[9,11,"qq"],[13,15,"mn"]]],["نَارٌ حَامِيَةٌۢ",600,30,240,0,"إنها نار قد حَمِيت من الوقود عليها.","نَارٌ حَامِيَةٌ",[]]]