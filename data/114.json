[[" قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ",604,30,240,0,"قل -أيها الرسول-: أعوذ وأعتصم برب الناس، القادر وحده على ردِّ شر الوسواس.","قُلْ أَعُوذُ بِرَبِّ النَّاسِ",[[22,23,"hw"],[23,24,"ls"],[24,26,"gh"],[26,28,"mp"]]],["مَلِكِ ٱلنَّاسِ",604,30,240,0,"ملك الناس المتصرف في كل شؤونهم، الغنيِّ عنهم.","مَلِكِ النَّاسِ",[[7,8,"hw"],[8,9,"ls"],[9,11,"gh"],[11,13,"mp"]]],["إِلَـٰهِ ٱلنَّاسِ",604,30,240,0,"إله الناس الذي لا معبود بحق سواه.","إِلَٰهِ النَّاسِ",[[4,6,"mn"],[9,10,"hw"],[10,11,"ls"],[11,13,"gh"],[13,15,"mp"]]],["مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ",604,30,240,0,"من أذى الشيطان الذي يوسوس عند الغفلة، ويختفي عند ذكر الله.","مِن شَرِّ الْوَسْوَاسِ الْخَنَّاسِ",[[2,5,"ik"],[10,11,"hw"],[23,24,"hw"],[28,30,"gh"],[30,32,"mp"]]],["ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ",604,30,240,0,"الذي يبثُّ الشر والشكوك في صدور الناس.","الَّذِي يُوَسْوِسُ فِي صُدُورِ النَّاسِ",[[31,32,"hw"],[32,33,"ls"],[33,35,"gh"],[35,37,"mp"]]],["مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ",604,30,240,0,"من شياطين الجن والإنس.","مِنَ الْجِنَّةِ وَالنَّاسِ",[[5,6,"hw"],[10,12,"gh"],[18,19,"hw"],[19,20,"ls"],[20,22,"gh"],[22,24,"mp"]]]]