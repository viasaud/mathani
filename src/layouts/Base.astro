---
import "@fontsource/scheherazade-new/400.css";
import "../styles/global.css";
import "../styles/unslop.css";
import Star from "../components/Star.astro";
import Footer from "../components/Footer.astro";
import { DEFAULT_DESCRIPTION, HOME_TITLE, OG_SIZE, SITE_NAME, graph, ogHome, website } from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  current?: number; // surah to mark in the index
  context?: { title: string; meta?: string[] };
  reader?: boolean; // immersive reading: the header slides away while scrolling down
  cover?: boolean; // the page opens on the dark cover (home), so the header starts in its light-on-dark tone
  image?: string; // the share card (public/og/), see lib/seo.ts
  imageAlt?: string;
  type?: "website" | "article";
  noindex?: boolean; // kept out of search results (the 404 page)
  schema?: Record<string, unknown>[]; // schema.org descriptions of this page, added to the site's own
}

const {
  title,
  description = DEFAULT_DESCRIPTION,
  current = 0,
  context,
  reader = false,
  cover = false,
  image = ogHome,
  imageAlt = "مثاني: القرآن الكريم بمصحف المدينة مع التفسير الميسّر",
  type = "website",
  noindex = false,
  schema = [],
} = Astro.props;
const site = Astro.site!;
const fullTitle = title ? `${title} · ${SITE_NAME}` : HOME_TITLE;
// one address per page, without a trailing slash, as the links and the sitemap write it
const canonical = new URL(Astro.url.pathname.replace(/\/+$/, "") || "/", site);
const ogImage = new URL(image, site);
const ld = graph([website(site), ...schema]);
// ownership checks for Google Search Console and Bing Webmaster Tools, set in the deployment's environment variables
const verify = {
  "google-site-verification": import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION,
  "msvalidate.01": import.meta.env.PUBLIC_BING_SITE_VERIFICATION,
};
const modes = [["pages", "صفحات"], ["flow", "متصل"], ["list", "آية وتفسير"]];
// The lens at the rims of the liquid glass: two displacement maps, stretched over each control. Red moves pixels
// sideways near the left and right edges, green up and down near the top and bottom; mid-grey (128) leaves the middle
// untouched. Used by backdrop-filter: url(#lg) where the browser supports it (html.lg, global.css).
// edge: how far in from each rim the bending reaches, in percent of the control's width or height.
const map = (axis: "x" | "y", edge: number) => {
  const [x2, y2, c] = axis === "x" ? ["1", "0", (v: number) => `rgb(${v},0,0)`] : ["0", "1", (v: number) => `rgb(0,${v},0)`];
  const stops = [[0, 255], [edge, 128], [100 - edge, 128], [100, 0]];
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" preserveAspectRatio="none"><linearGradient id="g" x2="${x2}" y2="${y2}">${stops.map(([o, v]) => `<stop offset="${o}%" stop-color="${c(v)}"/>`).join("")}</linearGradient><rect width="100" height="100" fill="url(#g)"/></svg>`;
  return `data:image/svg+xml,${encodeURIComponent(svg)}`;
};
---

<!doctype html>
<html lang="ar" dir="rtl" data-mode="pages" data-tajweed="off" class={cover ? "on-cover" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/icons/favicon-48.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="application-name" content={SITE_NAME} />
    <meta name="apple-mobile-web-app-title" content={SITE_NAME} />
    <meta name="format-detection" content="telephone=no" />
    <link rel="preload" href="/fonts/thmanyah/thmanyahseriftext-Regular.woff2" as="font" type="font/woff2" crossorigin />
    {/* the face the first screen's title is set in: the regular cut for the cover's name, the bold one for the reading
         pages' running heads and surah plates */}
    <link rel="preload" href={`/fonts/thmanyah/thmanyahserifdisplay-${cover ? "Regular" : "Bold"}.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f3e8e3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1b050a" media="(prefers-color-scheme: dark)" />
    {/* the link preview: Open Graph for most apps, the Twitter card for X */}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="ar_AR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(OG_SIZE.width)} />
    <meta property="og:image:height" content={String(OG_SIZE.height)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script type="application/ld+json" set:html={ld} />
    {Object.entries(verify).map(([name, content]) => content && <meta name={name} content={content} />)}
    {/* Apply the saved theme, view, tajweed and size before first paint so nothing flashes. html.motion turns on the
         entrance choreography (motion.ts); if that script never runs, the content is shown anyway after a moment. */}
    <script is:inline>
      try {
        var d = document.documentElement;
        var g = function (k) { var v = localStorage.getItem("mushaf:" + k); return v == null ? null : JSON.parse(v); };
        // one of the three tones; with none chosen, the system's light or dark. A choice saved before the three
        // (the sepia paper) is carried to its nearest tone
        var t = g("theme");
        if (t === "sepia") t = "mid";
        if (t !== "light" && t !== "mid" && t !== "dark") t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        d.dataset.theme = t;
        d.dataset.mode = g("mode") || "pages";
        d.dataset.spread = g("spread") || "on";
        d.dataset.tajweed = g("tajweed") || "off";
        d.style.setProperty("--qsize", (g("size") || (innerWidth < 500 ? 25 : 28)) + "px");
      } catch (e) {}
      // the glass bends what is under its rims where the browser can do that in a backdrop (Chromium)
      try {
        var brands = (navigator.userAgentData && navigator.userAgentData.brands) || [];
        if (brands.some(function (b) { return b.brand === "Chromium"; }) && !matchMedia("(prefers-reduced-transparency: reduce)").matches) document.documentElement.classList.add("lg");
      } catch (e) {}
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("motion");
        setTimeout(function () { if (!window.__motion) document.documentElement.classList.remove("motion"); }, 2500);
      }
    </script>
    <slot name="head" />
  </head>
  <body class={reader ? "is-reader" : undefined}>
    <svg class="lg-defs" width="0" height="0" aria-hidden="true" focusable="false">
      {/* capsules: the bend reaches well in from the ends; panels: only a thin band at each rim, so what lies under
           their options is not distorted */}
      {([["lg", 16, 34, 22], ["lg-panel", 5, 5, 16]] as const).map(([id, ex, ey, scale]) => (
        <filter id={id} x="0" y="0" width="1" height="1" color-interpolation-filters="sRGB">
          <feImage href={map("x", ex)} x="0" y="0" width="100%" height="100%" preserveAspectRatio="none" result="mx" />
          <feImage href={map("y", ey)} x="0" y="0" width="100%" height="100%" preserveAspectRatio="none" result="my" />
          <feComposite in="mx" in2="my" operator="arithmetic" k2="1" k3="1" result="map" />
          <feDisplacementMap in="SourceGraphic" in2="map" scale={scale} xChannelSelector="R" yChannelSelector="G" />
        </filter>
      ))}
    </svg>
    {/* The controls float on their own layer above the content: capsules sized to what they hold, never a bar.
         Navigation (home, and on a reading page the surah title, which opens the index), search and, on the reading
         pages only, the reading settings each get their own. */}
    <header class="hd gutter" id="hd">
      <div class="hd-start">
      {/* Where you are and where you can go: the mark (home), and beside it the index. On the surah text view the index
           is opened by the surah's own title, with the page and juz beside it; the mushaf pages name those themselves. */}
      <nav class="cap glass cap-nav" aria-label="التنقل">
        <a class="brand" href="/" aria-label="مثاني، الصفحة الرئيسية">
          <span class="brand-mark" aria-hidden="true"><Star /></span>
          {!reader && <span class="brand-name">مثاني</span>}
        </a>
        <span class="cap-div" aria-hidden="true"></span>
        {reader && context ? (
          <button class="cap-title" data-open="drawer" aria-haspopup="dialog" aria-controls="drawer" title="فهرس السور">
            <span class="cap-title-text">
              <strong class="hd-title" id="ctx-title">{context.title}</strong>
              <span class="hd-meta" id="ctx-meta">{context.meta?.map((m) => <span>{m}</span>)}</span>
            </span>
            <svg class="cap-chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
          </button>
        ) : (
          <button class="cap-index" data-open="drawer" aria-haspopup="dialog" aria-controls="drawer">
            {/* a list read right to left: the marks at the start (right), the lines running left */}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h11M4 12h11M4 18h11"></path><path d="m19.5 4.5 1.5 1.5-1.5 1.5-1.5-1.5zM19.5 10.5l1.5 1.5-1.5 1.5-1.5-1.5zM19.5 16.5l1.5 1.5-1.5 1.5-1.5-1.5z" fill="currentColor" stroke-width="1"></path></svg>
            <span>الفهرس</span>
          </button>
        )}
      </nav>
      {/* search and jump, always there, right after the navigation */}
        <button class="cap glass cap-search" data-open="palette" aria-label="ابحث أو انتقل">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
          <span>ابحث أو انتقل</span>
          <kbd data-mod-k>⌘K</kbd>
        </button>
      </div>
      <div class="hd-actions">
        {/* on the home page, the book's three tones: a capsule like the others, each tone a small disc of its own paper
             with its gold star; the chosen one sits in a lit well. On a phone only the chosen tone shows, and a tap
             turns to the next (home.ts). shell.ts wires [data-theme-btn] */}
        {cover && (
          <div class="cap glass cap-tones" role="group" aria-label="لون المصحف">
            {[["light", "فاتح"], ["mid", "متوسط"], ["dark", "داكن"]].map(([t, label]) => (
              <button class="cap-tone" data-theme-btn={t} aria-pressed="false" aria-label={label} title={label}><Star filled /></button>
            ))}
          </div>
        )}
        {reader && (
        <div class="settings-wrap">
          <button class="cap glass cap-circle" id="settings-btn" aria-expanded="false" aria-controls="settings" aria-label="إعدادات القراءة" title="إعدادات القراءة">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path class="k1" d="M4 7h9M17 7h3"></path><path class="k2" d="M4 17h3M11 17h9"></path><circle class="k1" cx="15" cy="7" r="2"></circle><circle class="k2" cx="9" cy="17" r="2"></circle></svg>
          </button>
          <div class="settings glass glass-panel" id="settings" hidden role="dialog" aria-label="إعدادات القراءة">
            <h3>طريقة العرض</h3>
            <div class="mode-row">
              <div class="seg" role="group" aria-label="طريقة العرض">
                {modes.map(([m, label]) => <button data-mode-btn={m} aria-pressed="false">{label}</button>)}
              </div>
            </div>
            {/* the pages view fits the screen, so it offers one page or two instead of a text size */}
            <div class="set-pages">
              <div class="set-sep"></div>
              <h3>الصفحات <small>تظهر صفحتان حين تتسع الشاشة لهما</small></h3>
              <div class="mode-row">
                <div class="seg" role="group" aria-label="عدد الصفحات">
                  <button data-spread-btn="off" aria-pressed="false">صفحة واحدة</button>
                  <button data-spread-btn="on" aria-pressed="false">صفحتان</button>
                </div>
              </div>
            </div>
            <div class="set-sep set-text"></div>
            <h3 class="set-text">حجم الخط</h3>
            <div class="size-row set-text">
              <span class="aa sm">ب</span>
              <input class="range" id="size" type="range" min="20" max="44" step="1" aria-label="حجم الخط" />
              <span class="aa lg">ب</span>
            </div>
            <div class="set-sep"></div>
            <h3>المظهر</h3>
            <div class="themes" role="group" aria-label="المظهر">
              <button class="theme-opt" data-theme-btn="light"><i></i>فاتح</button>
              <button class="theme-opt" data-theme-btn="mid"><i></i>متوسط</button>
              <button class="theme-opt" data-theme-btn="dark"><i></i>داكن</button>
            </div>
            <div class="set-sep"></div>
            <label class="set-row">
              <span>ألوان التجويد <small>في النص المتصل وآية وتفسير</small></span>
              <input type="checkbox" class="switch" id="opt-tajweed" />
            </label>
          </div>
        </div>
        )}
      </div>
    </header>

    <slot />

    {!reader && <Footer />}

    <div class="scrim" id="scrim"></div>

    {/* The index: every surah, or the thirty juz, with where the reader stopped at the top. A panel from the right
         on wide screens, a sheet from the bottom on phones. Filled by shell.ts. */}
    <aside class="drawer glass glass-panel" id="drawer" role="dialog" aria-modal="true" aria-labelledby="ix-title" data-current={current} aria-hidden="true" tabindex="-1">
      <div class="ix-head">
        <div class="ix-top">
          <div>
            <h2 id="ix-title">الفهرس</h2>
            <p class="ix-count" id="ix-count" aria-live="polite">مئة وأربع عشرة سورة</p>
          </div>
          <button class="ib ix-close" data-close="drawer" aria-label="إغلاق الفهرس">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"></path></svg>
          </button>
        </div>
        <label class="ix-search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
          <input id="ix-q" type="search" placeholder="اسم السورة أو رقمها" autocomplete="off" enterkeyhint="go" aria-label="ابحث عن سورة" />
        </label>
        <div class="ix-bar">
          {/* a .seg, so motion.ts slides one marker between the tabs; here it is drawn as a gold underline */}
          <div class="seg ix-tabs" role="group" aria-label="ترتيب الفهرس">
            <button data-ix="surah" aria-pressed="true">السور</button>
            <button data-ix="juz" aria-pressed="false">الأجزاء</button>
          </div>
          <div class="ix-place" role="group" aria-label="مكان النزول">
            <button data-ix-place="m" aria-pressed="false">مكية</button>
            <button data-ix-place="d" aria-pressed="false">مدنية</button>
          </div>
        </div>
      </div>
      <nav class="ix-list" id="ix-list" aria-label="السور"><div class="ix-empty">جارٍ تحميل الفهرس…</div></nav>
      <div class="ix-foot">
        <a href="/search">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
          البحث في الآيات
        </a>
        <button type="button" data-open="palette">
          انتقل إلى صفحة أو آية
          <kbd data-mod-k>⌘K</kbd>
        </button>
      </div>
    </aside>

    {/* Search and jump: a surah, a page, a juz, a verse number or any word. Before typing it offers where the reader
         stopped and four places most people go; examples to try sit under the field. Filled by shell.ts. */}
    <dialog class="palette glass glass-panel" id="palette" aria-label="ابحث أو انتقل">
      <div class="pal-input">
        <span class="pal-lens" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg></span>
        <input id="pal-q" type="search" placeholder="سورة، صفحة، آية أو كلمة" autocomplete="off" enterkeyhint="go" role="combobox" aria-autocomplete="list" aria-expanded="true" aria-label="ابحث أو انتقل" aria-controls="pal-results" />
        <button class="ib pal-close" id="pal-close" type="button" aria-label="إغلاق">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"></path></svg>
        </button>
      </div>
      <div class="pal-try" role="group" aria-label="أمثلة">
        <span>جرّب</span>
        {["٢:٢٥٥", "صفحة ٥٠٠", "جزء ٣٠", "الصبر"].map((t) => <button type="button" data-try={t}>{t}</button>)}
      </div>
      <div class="pal-results" id="pal-results" aria-label="النتائج"></div>
      <div class="sr-only" id="pal-live" role="status" aria-live="polite"></div>
      <div class="pal-foot" aria-hidden="true">
        <span><kbd>↑</kbd><kbd>↓</kbd> تنقّل</span>
        <span><kbd>↵</kbd> افتح</span>
        <span><kbd>Esc</kbd> أغلق</span>
        <span><kbd>?</kbd> الاختصارات</span>
        <span class="pal-mark"><Star />مثاني</span>
      </div>
    </dialog>

    {/* the keyboard shortcuts, on ? (shell.ts): what works everywhere, while reading, and in the index; a page adds its
         own rows through the "keys" slot */}
    <dialog class="keys glass glass-panel" id="keys" aria-labelledby="keys-title" tabindex="-1">
      <div class="keys-head">
        <h2 id="keys-title">اختصارات لوحة المفاتيح</h2>
        <button class="ib" id="keys-close" type="button" aria-label="إغلاق">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"></path></svg>
        </button>
      </div>
      <section>
        <h3>في كل صفحة</h3>
        <dl>
          <div><dt>ابحث أو انتقل</dt><dd><kbd data-mod-k>⌘K</kbd><kbd>/</kbd></dd></div>
          <div><dt>أغلق اللوحة المفتوحة</dt><dd><kbd>Esc</kbd></dd></div>
          <div><dt>هذه القائمة</dt><dd><kbd>?</kbd></dd></div>
        </dl>
      </section>
      {reader && (
        <section>
          <h3>أثناء القراءة</h3>
          <dl>
            <div><dt>التالية</dt><dd><kbd>←</kbd></dd></div>
            <div><dt>السابقة</dt><dd><kbd>→</kbd></dd></div>
            <div><dt>الآية التالية والسابقة، والآية مفتوحة</dt><dd><kbd>←</kbd><kbd>→</kbd></dd></div>
            <slot name="keys" />
          </dl>
        </section>
      )}
      <section>
        <h3>في الفهرس</h3>
        <dl>
          <div><dt>تنقّل بين السور</dt><dd><kbd>↑</kbd><kbd>↓</kbd></dd></div>
          <div><dt>افتح السورة</dt><dd><kbd>↵</kbd></dd></div>
        </dl>
      </section>
    </dialog>

    <script>
      import "../scripts/shell.ts";
      import "../scripts/motion.ts";
    </script>
  </body>
</html>
