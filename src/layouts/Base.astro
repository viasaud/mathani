---
import "@fontsource/scheherazade-new/400.css";
import "../styles/global.css";
import Star from "../components/Star.astro";

interface Props {
  title?: string;
  description?: string;
  current?: number; // surah to mark in the index
  context?: { title: string; meta?: string[] };
  reader?: boolean; // immersive reading: the header slides away while scrolling down
}

const SITE_NAME = "مثاني";
const {
  title,
  description = "اقرأ القرآن الكريم في صفحات مصحف المدينة، مع التفسير الميسّر والبحث في الآيات.",
  current = 0,
  context,
  reader = false,
} = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site);
const modes = [["pages", "صفحات"], ["flow", "متصل"], ["list", "آية وتفسير"]];
---

<!doctype html>
<html lang="ar" dir="rtl" data-mode="pages" data-tajweed="off">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/thmanyah/thmanyahseriftext-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#edefea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a100e" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ar_AR" />
    <meta property="og:url" content={canonical} />
    <!-- Apply the saved theme, view, tajweed and size before first paint so nothing flashes. -->
    <script is:inline>
      try {
        var d = document.documentElement;
        var g = function (k) { var v = localStorage.getItem("mushaf:" + k); return v == null ? null : JSON.parse(v); };
        var t = g("theme");
        if (t) d.dataset.theme = t;
        d.dataset.mode = g("mode") || "pages";
        d.dataset.spread = g("spread") || "on";
        d.dataset.tajweed = g("tajweed") || "off";
        d.style.setProperty("--qsize", (g("size") || (innerWidth < 500 ? 25 : 28)) + "px");
      } catch (e) {}
    </script>
    <slot name="head" />
  </head>
  <body class={reader ? "is-reader" : undefined}>
    <!-- The controls float on their own layer above the content: capsules sized to what they hold, never a bar.
         Navigation (home, and on a reading page the surah title, which opens the index), search and settings
         each get their own. -->
    <header class="hd gutter" id="hd">
      <nav class="cap glass cap-nav" aria-label="التنقل">
        <a class="cap-btn brand" href="/" aria-label="مثاني، الصفحة الرئيسية">
          <Star />
          {!reader && <span class="brand-name">مثاني</span>}
        </a>
        {reader && context ? (
          <button class="cap-title" data-open="drawer" aria-haspopup="dialog" title="فهرس السور">
            <strong class="hd-title" id="ctx-title">{context.title}</strong>
            <span class="hd-meta" id="ctx-meta">{context.meta?.map((m) => <span>{m}</span>)}</span>
          </button>
        ) : (
          <button class="cap-btn" data-open="drawer" aria-haspopup="dialog" aria-label="فهرس السور" title="فهرس السور">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M10 12h10M4 18h16"></path></svg>
          </button>
        )}
      </nav>
      <div class="hd-actions">
        <button class="cap glass cap-search" data-open="palette" aria-label="ابحث أو انتقل">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
          <span>ابحث أو انتقل</span>
          <kbd data-mod-k>⌘K</kbd>
        </button>
        <div class="settings-wrap">
          <button class="cap glass cap-circle" id="settings-btn" aria-expanded="false" aria-controls="settings" aria-label="إعدادات القراءة" title="إعدادات القراءة">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h9M17 7h3M4 17h3M11 17h9"></path><circle cx="15" cy="7" r="2"></circle><circle cx="9" cy="17" r="2"></circle></svg>
          </button>
          <div class="settings glass glass-panel" id="settings" hidden role="dialog" aria-label="إعدادات القراءة">
            <h3>طريقة العرض</h3>
            <div class="mode-row">
              <div class="seg" role="group" aria-label="طريقة العرض">
                {modes.map(([m, label]) => <button data-mode-btn={m} aria-pressed="false">{label}</button>)}
              </div>
            </div>
            <!-- the pages view fits the screen, so it offers one page or two instead of a text size -->
            <div class="set-pages">
              <div class="set-sep"></div>
              <h3>الصفحات <small>تظهر صفحتان حين تتسع الشاشة لهما</small></h3>
              <div class="mode-row">
                <div class="seg" role="group" aria-label="عدد الصفحات">
                  <button data-spread-btn="off" aria-pressed="false">صفحة واحدة</button>
                  <button data-spread-btn="on" aria-pressed="false">صفحتان</button>
                </div>
              </div>
            </div>
            <div class="set-sep set-text"></div>
            <h3 class="set-text">حجم الخط</h3>
            <div class="size-row set-text">
              <span class="aa sm">ب</span>
              <input class="range" id="size" type="range" min="20" max="44" step="1" aria-label="حجم الخط" />
              <span class="aa lg">ب</span>
            </div>
            <div class="set-sep"></div>
            <h3>المظهر</h3>
            <div class="themes" role="group" aria-label="المظهر">
              <button class="theme-opt" data-theme-btn="auto"><i></i>تلقائي</button>
              <button class="theme-opt" data-theme-btn="light"><i></i>فاتح</button>
              <button class="theme-opt" data-theme-btn="sepia"><i></i>ورقي</button>
              <button class="theme-opt" data-theme-btn="dark"><i></i>داكن</button>
            </div>
            <div class="set-sep"></div>
            <label class="set-row">
              <span>ألوان التجويد <small>في النص المتصل وآية وتفسير</small></span>
              <input type="checkbox" class="switch" id="opt-tajweed" />
            </label>
          </div>
        </div>
      </div>
    </header>

    <slot />

    <div class="scrim" id="scrim"></div>

    <aside class="drawer glass glass-panel" id="drawer" role="dialog" aria-modal="true" aria-label="فهرس السور" data-current={current} aria-hidden="true" tabindex="-1">
      <div class="drawer-head">
        <div class="drawer-title">
          <h2>الفهرس</h2>
          <button class="ib" data-close="drawer" aria-label="إغلاق الفهرس">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"></path></svg>
          </button>
        </div>
        <label class="field">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
          <input id="ix-q" type="search" placeholder="اسم السورة أو رقمها" autocomplete="off" aria-label="ابحث عن سورة" />
        </label>
        <div class="drawer-tabs">
          <div role="group" aria-label="ترتيب الفهرس" style="display:contents">
            <button class="chip" data-ix="surah" aria-pressed="true">السور</button>
            <button class="chip" data-ix="juz" aria-pressed="false">الأجزاء</button>
          </div>
          <span class="tabs-sep" aria-hidden="true"></span>
          <div role="group" aria-label="مكان النزول" style="display:contents">
            <button class="chip" data-ix-place="m" aria-pressed="false">مكية</button>
            <button class="chip" data-ix-place="d" aria-pressed="false">مدنية</button>
          </div>
        </div>
      </div>
      <nav class="drawer-list" id="ix-list"><div class="ix-empty">جارٍ تحميل الفهرس…</div></nav>
    </aside>

    <dialog class="palette" id="palette" aria-label="ابحث أو انتقل">
      <div class="pal-input">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
        <input id="pal-q" type="search" placeholder="سورة أو صفحة أو ٢:٢٥٥ أو كلمة" autocomplete="off" enterkeyhint="go" role="combobox" aria-autocomplete="list" aria-expanded="true" aria-label="ابحث أو انتقل" aria-controls="pal-results" />
        <kbd>Esc</kbd>
        <button class="ib pal-close" id="pal-close" type="button" aria-label="إغلاق">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"></path></svg>
        </button>
      </div>
      <div class="pal-results" id="pal-results" aria-label="النتائج"></div>
      <div class="sr-only" id="pal-live" role="status" aria-live="polite"></div>
      <div class="pal-foot">
        <span><kbd>↑</kbd><kbd>↓</kbd> للتنقل</span>
        <span><kbd>↵</kbd> للفتح</span>
        <span><kbd data-mod-k>⌘K</kbd> للفتح من أي مكان</span>
      </div>
    </dialog>

    <script>
      import "../scripts/shell.ts";
    </script>
  </body>
</html>
