.00 C526.00,461.34 525.01,462.50 523.67,462.50 L522.91,462.50 L493.81,433.31 C477.80,417.26 452.61,391.92 437.84,377.00 C401.03,339.84 402.32,341.08 401.19,342.00 L400.62,342.46 L400.45,354.73 C400.35,361.48 400.04,372.43 399.75,379.07 C399.09,394.63 398.83,403.44 398.51,422.00 C398.19,440.21 397.86,452.70 397.37,465.25 C397.17,470.41 396.89,481.49 396.75,489.88 C396.52,504.01 396.01,521.42 395.52,532.08 L395.32,536.54 L394.82,537.21 C394.16,538.10 393.00,538.47 390.75,538.49 C389.72,538.49 386.18,538.73 382.88,539.00 C375.68,539.60 370.02,539.59 362.88,538.99 Z" /></svg>
        <span class="credit-text"><span>تصميم وتطوير</span><span class="credit-name">سعود الشهري</span></span>
      </a>
    </div>
  </div>

</footer>

<style>
  .foot { position: relative; isolation: isolate; overflow: clip; margin-top: 96px; color: var(--ink); }

  /* on a phone the name and links come first and the scene under them; on a wider screen they share one cell, the
     name in the sky above the mosque */
  .foot-stage { display: grid; grid-template-columns: minmax(0, 1fr); }
  .foot-text { z-index: 1; display: grid; justify-items: center; gap: 8px; padding: 56px 16px 8px; text-align: center; }
  .foot-mark {
    display: inline-flex; align-items: center; gap: 12px; padding-inline: 4px; border-radius: 12px;
    font-family: var(--f-display); font-weight: 400; font-size: clamp(40px, 5vw, 52px); line-height: 1.3; color: var(--gold-text);
  }
  /* the display face sits low in its box (its tall dots and marks above), so the star comes down to the word's body */
  .foot-mark :global(.foot-star) { width: 0.78em; height: 0.78em; translate: 0 0.14em; animation: turn 60s linear infinite; }

  /* the ways in, on one line between dots, underlined in gold when pointed at */
  .foot-links { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; margin: 0; padding: 0; list-style: none; }
  .foot-links li { display: flex; align-items: center; }
  .foot-links li + li::before { content: "·"; color: color-mix(in srgb, var(--muted) 60%, transparent); padding-inline: 4px; }
  .foot-links :is(a, button) {
    display: inline-flex; align-items: center; min-height: 44px; padding-inline: 6px; border-radius: 10px;
    font-size: 15px; color: var(--ink-2); text-decoration: underline 1px transparent; text-underline-offset: 0.4em;
    transition: color var(--t-1) ease, text-decoration-color var(--t-1) ease;
  }
  .foot-links :is(a, button):is(:hover, :focus-visible) { color: var(--ink); text-decoration-color: var(--gold); }

  /* the engraving is white on black and serves as a luminance mask: the gold shows through its lines and nothing
     through its black, so it prints like ink on whatever paper the theme lays down */
  .foot-scene {
    --scene: url("/footer-scene.svg");
    width: 100%; height: 260px; pointer-events: none; background: var(--scene-ink);
    -webkit-mask: var(--scene) 50% 100% / cover no-repeat; mask: var(--scene) 50% 100% / cover no-repeat;
    mask-mode: luminance; -webkit-mask-source-type: luminance;
  }
  /* the ink: the deep gold of the text on light paper, the warm gold of the leaf on dark */
  .foot { --scene-ink: var(--gold); }

  @media (min-width: 768px) {
    .foot-text, .foot-scene { grid-area: 1 / 1; }
    .foot-text { align-self: start; padding-top: clamp(56px, 6vw, 88px); }
    .foot-scene { height: max(33.333vw, 440px); }
  }

  /* the credit, quietly, at the foot of the drawing, in the calm stretch of ground under the central gate */
  .foot { padding-bottom: env(safe-area-inset-bottom, 0px); }
  .foot-stage { position: relative; }
  .foot-credit {
    position: absolute; z-index: 1; left: 50%; bottom: clamp(2px, 1.2vw, 14px); translate: -50% 0;
    display: flex; justify-content: center; font-size: 13px; color: var(--muted); white-space: nowrap;
  }
  .credit-link { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; border-radius: 10px; color: var(--muted); }
  .credit-text { display: inline-flex; align-items: baseline; gap: 0.4em; }
  /* the name's ink, which pointing at the credit turns to gold; registered so it fades rather than flips, and so the
     sheen below keeps running through it instead of being switched off */
  @property --name-ink { syntax: "<color>"; inherits: true; initial-value: transparent; }
  .credit-link { --name-ink: var(--ink); transition: --name-ink var(--t-2) ease; }
  .credit-link:is(:hover, :focus-visible) { --name-ink: var(--gold); }
  .credit-name { font-family: var(--f-display); font-size: 15px; color: var(--name-ink); }
  .credit-mark { width: 20px; height: 20px; flex: none; fill: var(--name-ink); }
  /* every few seconds a gold light passes over the name, in the reading direction, and the mark catches it first */
  @media (prefers-reduced-motion: no-preference) {
    .credit-name {
      background: linear-gradient(100deg, var(--name-ink) 0 40%, var(--gold) 50%, var(--name-ink) 60% 100%) 0 0 / 260% 100% no-repeat;
      -webkit-background-clip: text; background-clip: text; color: transparent;
      animation: credit-sheen 7s var(--e-in-out) infinite;
    }
    .credit-mark { animation: credit-glint 7s ease-in-out infinite; }
  }
  @keyframes credit-sheen { 0%, 58% { background-position: 0 0; } 86%, 100% { background-position: 100% 0; } }
  @keyframes credit-glint { 0%, 54% { fill: var(--name-ink); } 62% { fill: var(--gold); } 76%, 100% { fill: var(--name-ink); } }

  @media (max-width: 640px) {
    .foot { margin-top: 64px; }
    /* the links wrap here, so they are spaced rather than dotted: a dot would be left at the start of a line */
    .foot-links { gap: 0 12px; }
    .foot-links li + li::before { content: none; }
    .foot-scene { margin-top: -24px; height: 300px; }
    /* the strip of ground is shallower at this size, so the credit is a little more compact */
    .credit-link { min-height: 36px; }
  }
  @media (prefers-reduced-motion: reduce) { .foot-mark :global(.foot-star) { animation: none; } }
</style>
