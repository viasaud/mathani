---
// The back cover: Madinah engraved in gold across the foot of the page, the Prophet's Mosque with its minarets, the
// Green Dome and the umbrellas of its courtyard, palms and old houses either side and Uhud behind, with the name and
// the ways in set in the sky above it. Under it the credit. It sits on the page's own background and the engraving is
// printed in the theme's gold, so the page simply runs on into it, whatever the theme.
import Star from "./Star.astro";

const links = [
  { href: "/page/1", label: "الصفحة الأولى" },
  { href: "/search", label: "البحث في الآيات" },
  { open: "drawer", label: "فهرس السور" },
  { open: "palette", label: "انتقل إلى صفحة أو آية" },
];
---

<footer class="foot">
  <div class="foot-stage">
    <div class="foot-text">
      <a class="foot-mark" href="/" aria-label="مثاني، الصفحة الرئيسية"><Star class="foot-star" />مثاني</a>
      <nav aria-label="روابط الموقع">
        <ul class="foot-links">
          {links.map((l) => (
            <li>{l.href ? <a href={l.href}>{l.label}</a> : <button type="button" data-open={l.open}>{l.label}</button>}</li>
          ))}
        </ul>
      </nav>
    </div>

    <!-- Madinah engraved (src/lib/scene.ts), one cached file for every page, printed in the theme's ink -->
    <div class="foot-scene" aria-hidden="true"></div>
    <!-- the credit sits in the drawing, in the pause the ground's strokes leave under the central gate -->
    <div class="foot-credit">
      <a class="credit-link" href="https://saud.sh" target="_blank" rel="author noopener">
        <!-- Saud's own mark, its viewBox cropped to the glyph -->
