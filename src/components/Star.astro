---
// The eight-pointed star of the rub' al-hizb (۞): the site's mark, and the frame of every number badge. Drawn once in
// the layout's sprite (Base.astro) and referenced here, so a page of a hundred badges carries one copy of the paths.
// plain: without the small ring at its heart, for a star a number sits in; filled: solid gold.
interface Props {
  class?: string;
  plain?: boolean;
  filled?: boolean;
}
const { class: cls, plain = false, filled = false } = Astro.props;
---

<svg class={cls} viewBox="0 0 48 48" fill={filled ? "currentColor" : "none"} aria-hidden="true"><use href={plain || filled ? "#star" : "#star-ring"}></use></svg>
