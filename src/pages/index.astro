---
import Base from "../layouts/Base.astro";
import "../styles/home.css";
import Star from "../components/Star.astro";
import { ar, ayahs, JUZ_NAMES, placeLabel } from "../lib/arabic";
import { getChapters, getJuz, getVerses } from "../lib/quran";

const chapters = getChapters();
const { starts } = getJuz();
const startPage = chapters.map((c) => getVerses(c.id)[0][1]);

// The hero rosette: an eight-fold pattern built from the rub' al-hizb star.
const C = 300;
const pt = (r: number, deg: number) => {
  const t = ((deg - 90) * Math.PI) / 180;
  return [C + r * Math.cos(t), C + r * Math.sin(t)].map((n) => n.toFixed(2)).join(" ");
};
const polygon = (r: number, step: number, offset = 0, n = 8) =>
  "M" + Array.from({ length: n }, (_, i) => pt(r, offset + ((i * step) % n) * (360 / n))).join(" L") + " Z";
const square = (r: number, rot: number) => "M" + [0, 90, 180, 270].map((d) => pt(r, d + 45 + rot)).join(" L") + " Z";
const shapes = [
  { d: square(250, 0), cls: "g" },
  { d: square(250, 45), cls: "g" },
  { d: polygon(196, 3, 22.5), cls: "g" },
  { d: square(120, 22.5), cls: "i" },
  { d: square(120, 67.5), cls: "i" },
  ...Array.from({ length: 16 }, (_, k) => ({ d: `M${pt(64, k * 22.5)} L${pt(120, k * 22.5)}`, cls: "g" })),
  ...Array.from({ length: 8 }, (_, k) => ({ d: `M${pt(214, k * 45)} L${pt(292, k * 45)}`, cls: "i" })),
];
const circles = [
  { r: 292, cls: "i" }, { r: 250, cls: "g" }, { r: 214, cls: "i" }, { r: 120, cls: "g" }, { r: 64, cls: "g" },
  ...Array.from({ length: 8 }, (_, k) => ({ r: 22, cls: "i", at: pt(158, k * 45 + 22.5) })),
];
const quick = [
  { label: "الكهف", href: "/surah/18" }, { label: "يس", href: "/surah/36" }, { label: "الرحمن", href: "/surah/55" },
  { label: "الملك", href: "/surah/67" }, { label: "آية الكرسي", href: "/surah/2#a255" }, { label: "خواتيم البقرة", href: "/surah/2#a285" },
];
---

<Base>
  <main class="home">
    <section class="hero gutter">
      <div class="hero-inner">
        <div class="hero-copy">
          <span class="eyebrow">القرآن الكريم · مصحف المدينة النبوية</span>
          <h1>مثاني</h1>
          <p class="epigraph">﴿كِتَٰبٗا مُّتَشَٰبِهٗا مَّثَانِيَ﴾ <small>الزمر ٢٣</small></p>
          <p class="hero-lead">صفحات المصحف كما طُبعت، سطرًا بسطر. اضغط أي آية لتقرأ تفسيرها الميسّر، وابحث في القرآن كله بكلمة.</p>
          <h2 class="sr-only" id="continue-title">تابع القراءة</h2>
          <a class="continue" id="continue" href="/page/1" data-names={JSON.stringify(chapters.map((c) => c.name))} data-pages={JSON.stringify(startPage)}>
            <div class="ring" aria-hidden="true">
              <svg viewBox="0 0 88 88"><circle class="track" cx="44" cy="44" r="38" fill="none" stroke-width="6"></circle><circle class="bar" id="ring-bar" cx="44" cy="44" r="38" fill="none" stroke-width="6" pathLength="100" stroke-dasharray="100" stroke-dashoffset="100"></circle></svg>
              <b><span id="ring-pct" hidden></span><Star class="ring-star" filled /></b>
            </div>
            <div class="continue-copy">
              <small id="continue-eyebrow">ابدأ رحلتك</small>
              <strong id="continue-title-text">سورة الفاتحة</strong>
              <span id="continue-sub">الصفحة ١ من ٦٠٤</span>
            </div>
            <span class="go" aria-hidden="true"><span id="continue-cta">ابدأ القراءة</span><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m15 6-6 6 6 6"></path></svg></span>
          </a>
          <button type="button" class="hero-search" data-open="palette" data-own-search aria-keyshortcuts="Meta+K Control+K">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
            <span>ابحث عن سورة أو صفحة أو كلمة</span>
            <kbd aria-hidden="true">⌘K</kbd>
          </button>
          <nav class="quick" aria-label="وصول سريع">
            {quick.map((q) => <a class="chip" href={q.href}>{q.label}</a>)}
          </nav>
        </div>
        <div class="hero-art" aria-hidden="true">
          <svg viewBox="0 0 600 600">
            <g class="rosette" fill="none" stroke-width="1.2" stroke-linejoin="round">
              {circles.map((c) => {
                const [cx, cy] = c.at ? c.at.split(" ") : [C, C];
                return <circle class={c.cls} cx={cx} cy={cy} r={c.r}></circle>;
              })}
              {shapes.map((s) => <path class={s.cls} d={s.d}></path>)}
              <path class="c" d={square(26, 0) + square(26, 45)} stroke="none"></path>
            </g>
          </svg>
        </div>
      </div>
    </section>

    <div class="wrap gutter">

      <section class="section" aria-labelledby="juz-title">
        <div class="section-head">
          <div>
            <h2 id="juz-title">الأجزاء</h2>
            <p>ثلاثون جزءًا، تحت كل رقم السورة والآية التي يبدأ بها.</p>
          </div>
        </div>
        <div class="juz-grid">
          {starts.map((s) => (
            <a class="juz-tile" href={`/surah/${s.surah}${s.ayah > 1 ? `#a${s.ayah}` : ""}`}
              aria-label={`الجزء ${JUZ_NAMES[s.juz]}، من سورة ${chapters[s.surah - 1].name}، الآية ${ar(s.ayah)}`}>
              <span class="juz-num">{ar(s.juz)}</span>
              <span class="juz-from">{chapters[s.surah - 1].name} <span class="num">{ar(s.ayah)}</span></span>
            </a>
          ))}
        </div>
      </section>

      <section class="section" aria-labelledby="surah-title">
        <div class="section-head">
          <div>
            <h2 id="surah-title">السور</h2>
            <p>مئة وأربع عشرة سورة بترتيب المصحف.</p>
          </div>
          <div class="filters seg" role="group" aria-label="تصفية السور">
            <button type="button" data-filter="" aria-pressed="true">الكل <span class="n">{ar(chapters.length)}</span></button>
            <button type="button" data-filter="makkah" aria-pressed="false">مكية <span class="n">{ar(chapters.filter((c) => c.place === "makkah").length)}</span></button>
            <button type="button" data-filter="madinah" aria-pressed="false">مدنية <span class="n">{ar(chapters.filter((c) => c.place === "madinah").length)}</span></button>
          </div>
        </div>
        <p class="sr-only" id="surah-count" role="status" aria-live="polite"></p>
        <div class="surah-grid" id="surah-grid">
          {chapters.map((c, i) => (
            <a class="surah-card" href={`/surah/${c.id}`} data-place={c.place}>
              <span class="badge"><Star /><span>{ar(c.id)}</span></span>
              <span class="txt"><span class="nm">{c.name}</span><span class="meta">{placeLabel(c.place)}، {ayahs(c.n)}</span></span>
              <span class="pg">ص {ar(startPage[i])}</span>
            </a>
          ))}
        </div>
      </section>

      <div class="page-end">
        <button type="button" class="to-top" id="to-top">
          إلى الأعلى
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 15 6-6 6 6"></path></svg>
        </button>
      </div>
    </div>
  </main>
</Base>

<script src="../scripts/home.ts"></script>
