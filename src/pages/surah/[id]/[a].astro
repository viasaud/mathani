---
// One page per verse: the verse, its tafsir, where it sits in the mushaf, and the way on to its neighbours, its surah
// and its mushaf page. A page of its own, so a search for a verse or its tafsir lands on exactly that.
import Base from "../../../layouts/Base.astro";
import "../../../styles/reader.css";
import Star from "../../../components/Star.astro";
import { ar, JUZ_NAMES, verseName } from "../../../lib/arabic";
import { getChapters, getNav, getTafsirSpans, getVerses, tafsirLabel, verseHtml, type Chapter } from "../../../lib/quran";
import { breadcrumbs, clip, ogSurah } from "../../../lib/seo";

export function getStaticPaths() {
  return getChapters().flatMap((chapter) =>
    getVerses(chapter.id).map((_, i) => ({ params: { id: String(chapter.id), a: String(i + 1) }, props: { chapter, i } })),
  );
}

interface Props {
  chapter: Chapter;
  i: number;
}

const { chapter: c, i } = Astro.props;
const chapters = getChapters();
const verses = getVerses(c.id);
const [text, page, juz, rub, sajda, , imlaei] = verses[i];
const a = i + 1;
const span = getTafsirSpans(c.id)[i];
const named = verseName(c.id, a);
const hizb = Math.ceil(rub / 4);
const startsRub = getNav().rubStarts.has(`${c.id}:${a}`);
// the verse before and after, across the ends of the surah
const prevChapter = chapters[c.id - 2];
const nextChapter = chapters[c.id];
const prev = a > 1 ? { s: c, a: a - 1 } : prevChapter && { s: prevChapter, a: prevChapter.n };
const next = a < c.n ? { s: c, a: a + 1 } : nextChapter && { s: nextChapter, a: 1 };

// «تفسير آية الكرسي، الآية ٢٥٥ من سورة البقرة»; a name that already says its surah needs it only once
const title = named
  ? `تفسير ${named}، الآية ${ar(a)}${named.includes("سورة") ? "" : ` من سورة ${c.name}`}`
  : `تفسير الآية ${ar(a)} من سورة ${c.name}`;
// what a search result shows: which verse, its first words in plain spelling, then the start of its tafsir
const description = `الآية ${ar(a)} من سورة ${c.name}${named ? `، ${named}` : ""}: ﴿${clip(imlaei.replace("۞", "").trim(), 70)}﴾ تفسيرها الميسّر: ${clip(span.text, 110)}`;

const site = Astro.site!;
const surahUrl = new URL(`/surah/${c.id}`, site).href;
const url = new URL(`/surah/${c.id}/${a}`, site).href;
const schema = [
  {
    "@type": "Chapter",
    "@id": `${surahUrl}#surah`,
    url: surahUrl,
    name: `سورة ${c.name}`,
    position: c.id,
    isPartOf: { "@id": new URL("/#quran", site).href },
  },
  {
    "@type": "Quotation",
    "@id": `${url}#ayah`,
    url,
    name: `سورة ${c.name}، الآية ${ar(a)}`,
    ...(named && { alternateName: named }),
    text,
    position: a,
    inLanguage: "ar",
    isPartOf: { "@id": `${surahUrl}#surah` },
  },
  breadcrumbs(site, [
    { name: "مثاني", path: "/" },
    { name: `سورة ${c.name}`, path: `/surah/${c.id}` },
    { name: `الآية ${ar(a)}`, path: `/surah/${c.id}/${a}` },
  ]),
];
---

<Base
  title={title}
  description={description}
  image={ogSurah(c.id)}
  imageAlt={`سورة ${c.name}، الآية ${ar(a)}`}
  type="article"
  schema={schema}
  current={c.id}
>
  <main class="read gutter verse-page" id="verse" data-s={c.id} data-a={a} data-name={c.name}>
    <header class="surah-head">
      <div class="plate">
        <i></i><i></i><i></i><i></i>
        <span class="plate-side"><small>الآية</small><b>{ar(a)}</b></span>
        <h1>سورة {c.name}<span class="sr-only">، الآية {ar(a)}</span></h1>
        <span class="plate-side"><small>من</small><b>{ar(c.n)}</b></span>
      </div>
      <p class="surah-meta">
        {named && <span class="named">{named}</span>}
        <a href={`/page/${page}#v${c.id}-${a}`}>صفحة {ar(page)}</a><span aria-hidden="true">·</span>
        <a href={`/juz/${juz}`}>الجزء {JUZ_NAMES[juz]}</a><span aria-hidden="true">·</span>
        الحزب {ar(hizb)}
      </p>
    </header>

    <article class="text-sheet">
      <div class="verses">
        <section class="v">
          <div class="v-top">
            <span class="v-num">
              <span class="badge"><Star /><span>{ar(a)}</span></span>
              <span class="v-meta"><span>سورة {c.name}</span>{startsRub && <span class="v-rub" title="بداية ربع حزب"><b class="rub-mark" aria-hidden="true">۞</b> <span class="v-rub-text">بداية ربع</span></span>}</span>
            </span>
            <div class="v-tools" role="group" aria-label="أدوات الآية">
              <button class="ib" id="v-copy" aria-label="نسخ الآية" title="نسخ الآية">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="12" height="12" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"></path></svg>
              </button>
              <button class="ib" id="v-link" aria-label="نسخ رابط الآية" title="نسخ رابط الآية">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"></path><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"></path></svg>
              </button>
            </div>
          </div>
          <div class="v-text"><span class="t" set:html={verseHtml(verses[i])} />{sajda ? <span class="sajda">سجدة</span> : null}{" "}<span class="end">۝{ar(a)}</span></div>
          <div class="tafsir">
            <h2>{tafsirLabel(span)}</h2>
            <p>{span.text}</p>
            {span.end > span.start && (
              <nav class="v-span" aria-label="الآيات التي يجمعها هذا التفسير">
                {verses.slice(span.start, span.end + 1).map((_, k) => {
                  const n = span.start + k + 1;
                  return n === a ? <span aria-current="page">{ar(n)}</span> : <a href={`/surah/${c.id}/${n}`}>{ar(n)}</a>;
                })}
              </nav>
            )}
          </div>
        </section>
      </div>
    </article>

    <div class="v-go">
      <a class="btn btn-primary" href={`/page/${page}#v${c.id}-${a}`}>اقرأها في المصحف، صفحة {ar(page)}</a>
      <a class="btn btn-ghost" href={`/surah/${c.id}#a${a}`}>اقرأها في سورة {c.name}</a>
    </div>

    <nav class="pager" aria-label="التنقل بين الآيات">
      {prev && <a href={`/surah/${prev.s.id}/${prev.a}`} rel="prev"><small>الآية السابقة</small><strong>{prev.s.name} {ar(prev.a)}</strong></a>}
      {next && <a href={`/surah/${next.s.id}/${next.a}`} rel="next"><small>الآية التالية</small><strong>{next.s.name} {ar(next.a)}</strong></a>}
    </nav>
  </main>
</Base>

<script>
  import { copyText, copyVerse } from "../../../lib/ui";

  const main = document.getElementById("verse")!;
  const copy = document.getElementById("v-copy")!;
  const link = document.getElementById("v-link")!;
  copy.addEventListener("click", () =>
    copyVerse(main.querySelector(".v-text .t")!.textContent!, main.dataset.name!, Number(main.dataset.a), copy));
  link.addEventListener("click", () => copyText(location.origin + location.pathname, "نُسخ رابط الآية", link));
</script>
