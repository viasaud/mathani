---
import Base from "../../layouts/Base.astro";
import "../../styles/reader.css";
import SurahText from "../../components/SurahText.astro";
import VerseSheet from "../../components/VerseSheet.astro";
import { ar, placeLabel } from "../../lib/arabic";
import { getChapters, getVerses, type Chapter } from "../../lib/quran";

export function getStaticPaths() {
  return getChapters().map((chapter) => ({ params: { id: String(chapter.id) }, props: { chapter } }));
}

interface Props {
  chapter: Chapter;
}

const { chapter } = Astro.props;
const verses = getVerses(chapter.id);
const chapters = getChapters();
const prev = chapters[chapter.id - 2];
const next = chapters[chapter.id];
const first = verses[0][1];
const last = verses[verses.length - 1][1];
const pagesLabel = first === last ? `صفحة ${ar(first)}` : `الصفحات ${ar(first)}–${ar(last)}`;
const description = `سورة ${chapter.name} (${placeLabel(chapter.place)}، ${ar(chapter.n)} آية) بالرسم العثماني مع التفسير الميسّر.`;
---

<Base
  title={`سورة ${chapter.name}`}
  description={description}
  current={chapter.id}
  context={{ title: `سورة ${chapter.name}`, meta: [placeLabel(chapter.place), `${ar(chapter.n)} آية`, pagesLabel] }}
  reader
>
  <!-- In the page view (the default), a surah link opens the mushaf page where the verse starts. -->
  <script is:inline slot="head" define:vars={{ s: chapter.id, pages: verses.map((v) => v[1]) }}>
    try {
      var mode = JSON.parse(localStorage.getItem("mushaf:mode"));
      if ((mode || "pages") === "pages") {
        var m = /^#a(\d{1,3})$/.exec(location.hash);
        var a = m ? Math.min(+m[1], pages.length) : 1;
        location.replace("/page/" + pages[a - 1] + (a > 1 ? "#v" + s + "-" + a : ""));
      }
    } catch (e) {}
  </script>

  <div class="progress" aria-hidden="true"><i id="progress"></i></div>
  <main class="read gutter" id="reader" data-surah={chapter.id} data-name={chapter.name}>
    <!-- the title plate of the printed mushaf: the surah's order on one side, its verse count on the other -->
    <header class="surah-head">
      <div class="plate">
        <span class="plate-side"><small>ترتيبها</small><b>{ar(chapter.id)}</b></span>
        <h1>سورة {chapter.name}</h1>
        <span class="plate-side"><small>آياتها</small><b>{ar(chapter.n)}</b></span>
      </div>
      <p class="surah-meta">{placeLabel(chapter.place)}<span aria-hidden="true">·</span>{pagesLabel}</p>
    </header>

    <SurahText chapter={chapter} verses={verses} />

    <nav class="pager" aria-label="التنقل بين السور">
      {prev && <a href={`/surah/${prev.id}`} rel="prev" id="prev"><small>السورة السابقة</small><strong>{prev.name}</strong></a>}
      {next && <a href={`/surah/${next.id}`} rel="next" id="next"><small>السورة التالية</small><strong>{next.name}</strong></a>}
    </nav>
  </main>

  <VerseSheet />
</Base>

<script src="../../scripts/reader.ts"></script>
