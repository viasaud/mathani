---
import Base from "../../layouts/Base.astro";
import "../../styles/reader.css";
import SurahText from "../../components/SurahText.astro";
import VerseSheet from "../../components/VerseSheet.astro";
import { ar, ayahs, placeLabel } from "../../lib/arabic";
import { getChapters, getVerses, type Chapter } from "../../lib/quran";
import { breadcrumbs, ogSurah, quranBook } from "../../lib/seo";

export function getStaticPaths() {
  return getChapters().map((chapter) => ({ params: { id: String(chapter.id) }, props: { chapter } }));
}

interface Props {
  chapter: Chapter;
}

const { chapter } = Astro.props;
const verses = getVerses(chapter.id);
const chapters = getChapters();
const prev = chapters[chapter.id - 2];
const next = chapters[chapter.id];
const first = verses[0][1];
const last = verses[verses.length - 1][1];
const pagesLabel = first === last ? `صفحة ${ar(first)}` : `الصفحات ${ar(first)}–${ar(last)}`;
// what a search result shows: what the page holds, then the facts people look for, then the words it opens with
const words = verses[0][0].trim().split(/\s+/);
const opening = words.slice(0, 6).join(" ") + (words.length > 6 ? "…" : "");
const where = first === last ? `في الصفحة ${ar(first)}` : `في الصفحات ${ar(first)}–${ar(last)}`;
const description = `اقرأ سورة ${chapter.name} كاملة بالرسم العثماني من مصحف المدينة، مع التفسير الميسّر لكل آية. سورة ${placeLabel(chapter.place)}، ${ayahs(chapter.n)}، ${where}. أولها: ﴿${opening}﴾`;
const site = Astro.site!;
const url = new URL(`/surah/${chapter.id}`, site).href;
const schema = [
  quranBook(site),
  {
    "@type": "Chapter",
    "@id": `${url}#surah`,
    url,
    name: `سورة ${chapter.name}`,
    alternateName: `Surah ${chapter.en}`,
    description,
    position: chapter.id,
    pageStart: first,
    pageEnd: last,
    inLanguage: "ar",
    isPartOf: { "@id": new URL("/#quran", site).href },
  },
  breadcrumbs(site, [
    { name: "مثاني", path: "/" },
    { name: `سورة ${chapter.name}`, path: `/surah/${chapter.id}` },
  ]),
];
---

<Base
  title={`سورة ${chapter.name} مكتوبة كاملة مع التفسير الميسّر`}
  description={description}
  image={ogSurah(chapter.id)}
  imageAlt={`سورة ${chapter.name}، ${placeLabel(chapter.place)}، ${ayahs(chapter.n)}`}
  type="article"
  schema={schema}
  current={chapter.id}
  context={{ title: `سورة ${chapter.name}`, meta: [placeLabel(chapter.place), `${ar(chapter.n)} آية`, pagesLabel] }}
  reader
>
  {/* In the page view (the default), a surah link opens the mushaf page where the verse starts: for a reader who chose
       the pages, or who followed a link here from another page of the site. Someone arriving from outside, from a
       search result or a shared link, reads the surah here, in the continuous text, and can switch to the pages from
       the settings; so does a search engine, which therefore finds this page's text and tafsir instead of a redirect.
       Once so, the visit stays in the text: the next surah from here is not an arrival from another page. */}
  <script is:inline slot="head" define:vars={{ s: chapter.id, pages: verses.map((v) => v[1]) }}>
    try {
      var mode = JSON.parse(localStorage.getItem("mushaf:mode"));
      var inside = false, stay = false;
      try { inside = !!document.referrer && new URL(document.referrer).origin === location.origin; } catch (e) {}
      try { stay = !!sessionStorage.getItem("mushaf:flow"); } catch (e) {}
      if (mode == null && (!inside || stay)) {
        document.documentElement.dataset.mode = "flow";
        try { sessionStorage.setItem("mushaf:flow", "1"); } catch (e) {}
      }
      else if ((mode || "pages") === "pages") {
        var m = /^#a(\d{1,3})$/.exec(location.hash);
        var a = m ? Math.max(1, Math.min(+m[1], pages.length)) : 1;
        location.replace("/page/" + pages[a - 1] + (a > 1 ? "#v" + s + "-" + a : ""));
      }
    } catch (e) {}
  </script>

  <div class="progress" aria-hidden="true"><i id="progress"></i></div>
  <main class="read gutter" id="reader" data-surah={chapter.id} data-name={chapter.name}>
    {/* the title plate of the printed mushaf: the surah's order on one side, its verse count on the other */}
    <header class="surah-head">
      <div class="plate">
        <i></i><i></i><i></i><i></i>
        <span class="plate-side"><small>ترتيبها</small><b>{ar(chapter.id)}</b></span>
        <h1>سورة {chapter.name}</h1>
        <span class="plate-side"><small>آياتها</small><b>{ar(chapter.n)}</b></span>
      </div>
      <p class="surah-meta">{placeLabel(chapter.place)}<span aria-hidden="true">·</span>{pagesLabel}</p>
    </header>

    <SurahText chapter={chapter} verses={verses} />

    <nav class="pager" aria-label="التنقل بين السور">
      {prev && <a href={`/surah/${prev.id}`} rel="prev" id="prev"><small>السورة السابقة</small><strong>{prev.name}</strong></a>}
      {next && <a href={`/surah/${next.id}`} rel="next" id="next"><small>السورة التالية</small><strong>{next.name}</strong></a>}
    </nav>
  </main>

  <VerseSheet />
</Base>

<script src="../../scripts/reader.ts"></script>
