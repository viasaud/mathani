---
// One page per juz: where it begins and ends, its pages (each a way into the mushaf), the surahs it takes in, and its
// eight quarters.
import Base from "../../layouts/Base.astro";
import "../../styles/reader.css";
import Star from "../../components/Star.astro";
import { ar, ayahs, JUZ_COMMON, JUZ_NAMES, surahCount } from "../../lib/arabic";
import { getChapters, getJuz, getNav, getVerses } from "../../lib/quran";
import { breadcrumbs } from "../../lib/seo";

export function getStaticPaths() {
  return Array.from({ length: 30 }, (_, i) => ({ params: { n: String(i + 1) } }));
}

const n = Number(Astro.params.n);
const chapters = getChapters();
const { starts } = getJuz();
const { rubs } = getNav();
const row = (s: number, a: number) => getVerses(s)[a - 1];
const opening = (s: number, a: number, count = 7) => {
  const words = row(s, a)[0].replace("۞", "").trim().split(/\s+/); // the quarter mark is shown on its own
  return words.slice(0, count).join(" ") + (words.length > count ? "…" : "");
};

const start = starts[n - 1];
// it ends on the verse before the next juz begins, or on the last verse of the Quran
const following = starts[n];
const end = !following
  ? { surah: 114, ayah: chapters[113].n }
  : following.ayah > 1
    ? { surah: following.surah, ayah: following.ayah - 1 }
    : { surah: following.surah - 1, ayah: chapters[following.surah - 2].n };
const firstPage = row(start.surah, start.ayah)[1];
const lastPage = row(end.surah, end.ayah)[1];
const name = (s: number) => chapters[s - 1].name;

// each surah it takes in, whole or in part
const surahs = chapters.slice(start.surah - 1, end.surah).map((c) => {
  const from = c.id === start.surah ? start.ayah : 1;
  const to = c.id === end.surah ? end.ayah : c.n;
  return { c, from, to, whole: from === 1 && to === c.n, page: row(c.id, from)[1] };
});
// its two hizb, each in four quarters; under the hizb's own heading a quarter is named by how far into it it begins
const QUARTERS = ["الحزب", "ربع الحزب", "نصف الحزب", "ثلاثة أرباع الحزب"];
const PART = ["أوله", "ربعه", "نصفه", "ثلاثة أرباعه"];
const quarters = rubs.slice((n - 1) * 8, n * 8).map(([s, a], k) => {
  const hizb = (n - 1) * 2 + Math.floor(k / 4) + 1;
  return { s, a, q: k % 4, hizb, label: `${QUARTERS[k % 4]} ${ar(hizb)}`, page: row(s, a)[1] };
});
const hizbs = [quarters.slice(0, 4), quarters.slice(4)];
// its pages, first to last, each with the quarter that begins on it (the first, if two do)
const pages = Array.from({ length: lastPage - firstPage + 1 }, (_, i) => {
  const p = firstPage + i;
  return { p, q: quarters.find((x) => x.page === p) };
});
// a quarter's mark: the hizb opens on ۞, as in the mushaf; its quarters on a ring filled as far as they are into it
const dial = (q: number) =>
  `<svg viewBox="0 0 20 20"><circle cx="10" cy="10" r="7" pathLength="4"/><circle class="arc" cx="10" cy="10" r="7" pathLength="4" stroke-dasharray="${q} 4"/></svg>`;

const common = JUZ_COMMON[n];
const ord = `الجزء ${JUZ_NAMES[n]}`;
const title = common ? `${common}، ${ord} من القرآن الكريم` : `${ord} من القرآن الكريم: بدايته ونهايته وسوره`;
const pagesLabel = `الصفحات ${ar(firstPage)}–${ar(lastPage)}`;
const names = surahs.map((x) => x.c.name);
const listed = names.length > 8 ? `${names.slice(0, 8).join("، ")} وغيرها` : names.join("، ");
// a juz inside one surah names it once: «كله من سورة البقرة، من الآية ١٤٢ إلى الآية ٢٥٢»
const description =
  `${ord} من القرآن الكريم${common ? `، ${common}` : ""}: ` +
  (names.length > 1
    ? `يبدأ من سورة ${name(start.surah)}، الآية ${ar(start.ayah)}، وينتهي بسورة ${name(end.surah)}، الآية ${ar(end.ayah)}، في ${pagesLabel} من مصحف المدينة. سوره: ${listed}.`
    : `كله من سورة ${names[0]}، من الآية ${ar(start.ayah)} إلى الآية ${ar(end.ayah)}، في ${pagesLabel} من مصحف المدينة.`);

const site = Astro.site!;
const schema = [
  breadcrumbs(site, [
    { name: "مثاني", path: "/" },
    { name: ord, path: `/juz/${n}` },
  ]),
];
---

<Base title={title} description={description} type="article" schema={schema}>
  <main class="read gutter juz-page">
    <header class="surah-head">
      <div class="plate">
        <i></i><i></i><i></i><i></i>
        <span class="plate-side"><small>حزباه</small><b>{ar(n * 2 - 1)}–{ar(n * 2)}</b></span>
        <h1>{ord}</h1>
        <span class="plate-side"><small>صفحاته</small><b>{ar(lastPage - firstPage + 1)}</b></span>
      </div>
      <p class="surah-meta">
        {common && <span class="named">{common}</span>}
        {pagesLabel} من مصحف المدينة
      </p>
    </header>

    <article class="text-sheet">
      {/* its first words and its last, each on one line across the sheet */}
      <div class="j-ends">
        {[["يبدأ من", start], ["وينتهي عند", end]].map(([label, v]) => {
          const { surah: s, ayah: a } = v as typeof start;
          return (
            <a class="j-end" href={`/surah/${s}/${a}`}>
              <span class="j-cap"><small>{label as string}</small> <span class="j-ref">سورة {name(s)}، الآية {ar(a)}</span></span>
              <span class="j-verse"><span class="orn">﴿</span><span class="j-verse-words">{opening(s, a, 14)}</span><span class="orn">﴾</span></span>
            </a>
          );
        })}
      </div>

      {/* the stretch of the mushaf it fills: a line for each page, from the first (right) to the last (left), the
           quarters marked where they fall, and under it a key to the marks */}
      <section class="j-sec" aria-labelledby="j-pages">
        <h2 id="j-pages">صفحاته<small>{ar(pages.length)} صفحة، من {ar(firstPage)} إلى {ar(lastPage)}</small></h2>
        <nav class="j-ruler" aria-labelledby="j-pages" style={`--n:${pages.length}`}>
          {pages.map(({ p, q }, i) => (
            <a href={`/page/${p}`} class={q ? "q" : undefined} style={`--i:${i}`} aria-label={`الصفحة ${ar(p)}${q ? `، ${q.label}` : ""}`}>
              {q && (q.q === 0 ? <span class="j-mark j-rub" aria-hidden="true">۞</span> : <span class="j-mark" aria-hidden="true" set:html={dial(q.q)} />)}
              <i></i>
              <small aria-hidden="true">{ar(p)}</small>
            </a>
          ))}
        </nav>
        <p class="j-key">
          <span><i aria-hidden="true"></i>كل خط صفحة، تفتحها في المصحف</span>
          <span><span class="j-mark j-rub" aria-hidden="true">۞</span>صفحة يبدأ فيها حزب</span>
          <span><span class="j-mark" aria-hidden="true" set:html={dial(1)} />صفحة يبدأ فيها ربع، أو نصف، أو ثلاثة أرباع</span>
        </p>
      </section>

      <section class="j-sec" aria-labelledby="j-surahs">
        <h2 id="j-surahs">{surahs.length === 1 ? "سورته" : "سوره"}<small>{surahCount(surahs.length)}</small></h2>
        <div class="j-list">
          {surahs.map(({ c, from, to, whole, page }) => (
            <a class="ix-item" href={`/surah/${c.id}${from > 1 ? `#a${from}` : ""}`}>
              <span class="ix-num"><Star /><b>{ar(c.id)}</b></span>
              <span class="ix-main"><span class="ix-name">{c.name}</span>
              <span class="ix-sub">{whole ? `كاملة، ${ayahs(c.n)}` : from === to ? `الآية ${ar(from)}` : `الآيات ${ar(from)}–${ar(to)}`}</span></span>
              <span class="ix-page">ص {ar(page)}</span>
            </a>
          ))}
        </div>
      </section>

      <section class="j-sec" aria-labelledby="j-quarters">
        <h2 id="j-quarters">أرباعه<small>ثمانية، في حزبين</small></h2>
        <div class="j-hizbs">
          {hizbs.map((rows) => (
            <div class="j-hizb">
              <h3>الحزب {ar(rows[0].hizb)}</h3>
              <ol>
                {rows.map(({ s, a, q, label, page }) => (
                  <li>
                    <a class="j-q" href={`/surah/${s}/${a}`} aria-label={`${label}: سورة ${name(s)}، الآية ${ar(a)}، صفحة ${ar(page)}`}>
                      {q === 0 ? <span class="j-mark j-rub" aria-hidden="true">۞</span> : <span class="j-mark" aria-hidden="true" set:html={dial(q)} />}
                      <span class="j-q-main">
                        <span class="j-q-name">{PART[q]}</span>
                        <span class="j-q-words">{opening(s, a, 5)}</span>
                      </span>
                      <span class="j-q-ref">{name(s)} {ar(a)}<small>ص {ar(page)}</small></span>
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      </section>
    </article>

    <nav class="pager" aria-label="التنقل بين الأجزاء">
      {n > 1 && <a href={`/juz/${n - 1}`} rel="prev"><small>الجزء السابق</small><strong>الجزء {JUZ_NAMES[n - 1]}</strong></a>}
      {n < 30 && <a href={`/juz/${n + 1}`} rel="next"><small>الجزء التالي</small><strong>الجزء {JUZ_NAMES[n + 1]}</strong></a>}
    </nav>
  </main>
</Base>
