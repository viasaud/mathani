---
import Base from "../layouts/Base.astro";
import Star from "../components/Star.astro";
---

<Base title="الصفحة غير موجودة" noindex>
  <main class="gutter">
    <section class="empty-state">
      <Star />
      <span class="eyebrow" data-reveal>٤٠٤</span>
      <h1 data-reveal>الصفحة غير موجودة</h1>
      <p data-reveal>الرابط الذي فتحته لا يقود إلى صفحة في الموقع. ابحث عن سورة أو صفحة، أو عد إلى البداية.</p>
      <div class="hero-actions" data-reveal>
        <a class="btn btn-primary" href="/">الصفحة الرئيسية</a>
        <button class="btn btn-ghost" data-open="palette">ابحث أو انتقل</button>
      </div>
    </section>
  </main>
</Base>

<style>
  /* the rule before the number would leave it off centre in a centred column: one on each side */
  .eyebrow::after { content: ""; width: 28px; height: 1px; background: currentColor; }
</style>
