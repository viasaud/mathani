---
import Base from "../layouts/Base.astro";
import Star from "../components/Star.astro";
---

<Base title="الصفحة غير موجودة">
  <main class="gutter">
    <section class="empty-state">
      <Star />
      <h1>الصفحة غير موجودة</h1>
      <p>الرابط الذي فتحته لا يقود إلى صفحة في الموقع. ابحث عن سورة أو صفحة، أو عد إلى البداية.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/">الصفحة الرئيسية</a>
        <button class="btn btn-ghost" data-open="palette">ابحث أو انتقل</button>
      </div>
    </section>
  </main>
</Base>
